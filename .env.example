# LLM 配置（也可在前端设置页配置，API Key 优先存入系统钥匙串）
LLM_PROVIDER=openai
LLM_BASE_URL=https://api.openai.com/v1
LLM_MODEL=gpt-4o
LLM_TEMPERATURE=0.3
LLM_MAX_TOKENS=4096

# 转换配置
MAX_CONCURRENT_REQUESTS=3
CHAPTER_RETRY_COUNT=2
QUALITY_MODE=standard

# 性能
CHAPTER_TIMEOUT_SECONDS=120
TOTAL_TIMEOUT_SECONDS=600

# 开发模式：无 API Key 时使用 Mock LLM
MOCK_LLM=false

# 数据目录（相对项目根目录）
DATA_DIR=data
